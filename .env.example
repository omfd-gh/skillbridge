# =============================================================================
# SkillBridge Environment Configuration Template
# Copy this file to .env and insert your API keys and Client IDs:
#   cp .env.example .env
# =============================================================================

# -----------------------------------------------------------------------------
# 1. Google Gemini API (Server-side AI Provider)
# -----------------------------------------------------------------------------
# Obtain your Gemini API key from Google AI Studio:
# https://aistudio.google.com/app/apikey
# NOTE: This key is used strictly server-side by the backend middleware in
# server/aiService.ts and is NEVER exposed or bundled into client-side JavaScript.
GEMINI_API_KEY=your_gemini_api_key_here

# Default Gemini model used for career guidance:
GEMINI_MODEL=gemini-3.5-flash-lite

# -----------------------------------------------------------------------------
# 2. Google Identity Services (GIS) Web Sign-In
# -----------------------------------------------------------------------------
# Obtain your OAuth 2.0 Web Client ID from Google Cloud Console:
# https://console.cloud.google.com/apis/credentials
# In Credentials > OAuth 2.0 Client IDs (Web application):
# - Add "http://localhost:5173" to "Authorized JavaScript origins"
# - Add "http://localhost:5173" to "Authorized redirect URIs"
VITE_GOOGLE_CLIENT_ID=your_google_client_id_here.apps.googleusercontent.com

# Server port (default: 5173)
PORT=5173
